NODE_ENV=production
PORT=3000
REALTIME_PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ydplay
REDIS_URL=redis://REDIS_HOST:6379

JWT_ACCESS_SECRET=GENERATE_32_PLUS_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
ADMIN_JWT_SECRET=GENERATE_DIFFERENT_32_PLUS_RANDOM_CHARACTERS
ADMIN_API_KEY=GENERATE_RANDOM_BOOTSTRAP_KEY_OR_LEAVE_UNSET_IF_NOT_USED

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_ACCESS_TOKEN_TTL_SECONDS=1800
SIGNUP_BONUS_COINS=1000

CORS_ORIGIN=https://admin.your-domain.example
REALTIME_ALLOWED_ORIGINS=https://app.your-domain.example,https://admin.your-domain.example
REALTIME_AUTH_TIMEOUT_MS=5000
REALTIME_HEARTBEAT_MS=15000
REALTIME_MAX_MESSAGES_PER_10S=60

# Generate exactly 32 random bytes, base64 encoded.
PUSH_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
PUSH_PROVIDER_URL=
PUSH_PROVIDER_BEARER_TOKEN=

NEXT_PUBLIC_YD_API_URL=https://api.your-domain.example/v1
