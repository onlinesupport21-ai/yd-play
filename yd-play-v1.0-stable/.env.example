NODE_ENV=development
PORT=3000
REALTIME_PORT=3001
DATABASE_URL=postgresql://ydplay:ydplay_dev@localhost:5432/ydplay
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-change-me
JWT_REFRESH_SECRET=dev-refresh-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SIGNUP_BONUS_COINS=1000
ADMIN_API_KEY=replace-with-at-least-24-random-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002
REALTIME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REALTIME_AUTH_TIMEOUT_MS=5000
REALTIME_HEARTBEAT_MS=15000
REALTIME_MAX_MESSAGES_PER_10S=60

ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_ACCESS_TOKEN_TTL_SECONDS=1800
ADMIN_WEB_ORIGIN=http://localhost:3002

# v0.9 notifications: generate a random 32-byte key and store as base64.
# Example: openssl rand -base64 32
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Optional provider-neutral HTTPS endpoint. If omitted, admin dispatch still creates in-app inbox items.
PUSH_PROVIDER_URL=
PUSH_PROVIDER_BEARER_TOKEN=
